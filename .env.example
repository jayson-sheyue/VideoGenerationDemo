# Google Cloud project with Agent Platform API enabled
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Reference images: download from HTTPS → upload here → Omni reads gs://
# Optional when the browser sends base64 reference_images.
INPUT_GCS_URI=gs://your-bucket/omni-input/

# Generated videos
OUTPUT_GCS_URI=gs://your-bucket/omni-output/

# Clash Mixed / Http port — required when oauth2.googleapis.com DNS fails without proxy.
# Local runs only: on Cloud Run these are ignored and stripped (see deploy/cloud-run.sh).
GOOGLE_API_TRUST_ENV=true
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

# Model id
OMNI_MODEL=gemini-omni-1.1-flash-preview

# Shot-list motion notes / follow-up suggestions (Vertex generateContent)
PROMPT_ENHANCE=true
PROMPT_ENHANCE_MODEL=gemini-2.5-flash
PROMPT_ENHANCE_LOCATION=global
